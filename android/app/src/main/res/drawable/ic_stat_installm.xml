<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar / notification small icon.

  Android uses only this icon's alpha channel and paints it itself (white on
  dark, dark on light), so it must be a single-colour silhouette on a
  transparent background. The launcher icon is a full-colour mipmap and shows up
  in the shade as a blank circle, which is why notifications use this instead.

  The two lines are holes cut with evenOdd, so the bubble reads at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M20,2H4C2.9,2 2,2.9 2,4v18l4,-4h14c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2zM7,9h10v2H7V9zM7,13h7v2H7V13z" />
</vector>
